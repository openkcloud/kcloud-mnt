# ════════════════════════════════════════════════════════════════
# openKcloud CMP 백엔드 — 환경 설정 예시
#   복사해서 config.env 로 저장 후 환경에 맞게 수정:
#     cp config.env.example config.env
#   실행: uvicorn main:app --host 0.0.0.0 --port 8000 --env-file config.env
#   ※ 모든 값은 미설정 시 "표준 클러스터(테스트베드/운영)" 기본값으로 동작
# ════════════════════════════════════════════════════════════════

# ── 공통 ──────────────────────────────────────────────────────────
# 포털(브라우저)이 접근하는 이 백엔드의 외부 주소 — IDE 접속 URL 발급에 사용
PUBLIC_BASE_URL=http://localhost:8000
# 포털 프론트엔드 origin (CORS 허용 목록, 콤마 구분)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 기본 네임스페이스 / 기본 노트북 이미지
DEFAULT_NAMESPACE=ai-research
DEFAULT_NOTEBOOK_IMAGE=kubeflownotebookswg/jupyter-scipy:v1.9.2
# LLM 실측 대상 (namespace/service) · 표시명 · 모델명
LLM_SERVICE=llm-serving/qwen-llm-predictor:80
LLM_NODE_DESC=
LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# 하드웨어 벤치마크 Job 이미지 (PyTorch+CUDA 포함 이미지)
BENCH_IMAGE=kubeflownotebookswg/jupyter-pytorch-cuda-full:v1.9.2

# ── 모델 저장소 (MinIO / S3 호환) ─────────────────────────────────
# 학습한 모델을 등록하고 KServe가 읽어가는 오브젝트 스토리지.
# 기본값은 Kubeflow Pipelines가 설치한 MinIO를 재사용한다.
# 운영/테스트베드에서는 사내 MinIO나 S3 주소로 교체하면 코드 수정 없이 동작.
MODEL_STORE_ENDPOINT=minio-service.kubeflow:9000
MODEL_STORE_BUCKET=models
MODEL_STORE_KEY=minio
MODEL_STORE_SECRET=minio123
# KServe가 s3:// 모델을 읽을 때 사용할 ServiceAccount 이름
#   (각 Profile 네임스페이스에 minio-s3-creds Secret + 이 SA가 있어야 함)
MODEL_STORE_SA=kserve-minio-sa
# GPU Pod에 지정할 RuntimeClass — k3s+nvidia-container-runtime 환경에서 필수.
# NVIDIA GPU Operator를 쓰는 클러스터에서는 빈 값으로 두면 된다.
GPU_RUNTIME_CLASS=nvidia
# 볼륨 스냅샷 보관 버킷 (모델 저장소와 같은 MinIO 사용)
SNAPSHOT_BUCKET=snapshots

# ── [로컬 WSL 개발환경 전용] — 테스트베드/운영에서는 반드시 비워둘 것 ──
# Pod을 특정 노드에 고정 (WSL 크로스노드 pod 네트워크 제약 우회)
DEV_PIN_NODE=
# Pod 외부통신 HTTP 프록시 (WSL Pod egress 제약 우회)
POD_HTTP_PROXY=
POD_NO_PROXY=localhost,127.0.0.1,10.0.0.0/8,192.168.0.0/24,.svc,.cluster.local

# ════════════════════════════════════════════════════════════════
# 프로필 예시 1) 로컬 WSL 개발환경 (오케스트로 하청 개발 PC)
# ════════════════════════════════════════════════════════════════
# DEV_PIN_NODE=gps-ud56fin
# POD_HTTP_PROXY=http://192.168.0.41:3128
# LLM_NODE_DESC=gps-ud56fin (RTX 4070)

# ════════════════════════════════════════════════════════════════
# 프로필 예시 2) 원청 테스트베드 (A100 클러스터)
# ════════════════════════════════════════════════════════════════
# PUBLIC_BASE_URL=https://cmp-api.testbed.okestro.local
# CORS_ORIGINS=https://portal.testbed.okestro.local
# DEV_PIN_NODE=            ← 비움 (스케줄러 자율 배치)
# POD_HTTP_PROXY=          ← 비움 (직접 통신)
# LLM_MODEL=upstage/SOLAR-10.7B-Instruct-v1.0   ← A100이면 대형 모델 가능
