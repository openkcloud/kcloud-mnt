# MNT-OBS 로컬 설정 — cp config.env.example config.env
# 프론트(localhost:3000)가 브라우저에서 호출하려면 CORS 필수
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

PROMETHEUS_URL=
LOKI_URL=
CORE_API_BASE=http://localhost:8000

# KCloud Monitor v2 (이노그리드) — 로컬 dev는 SSH 터널로 master3:8000 을 localhost:8000 에 포워딩
#   ssh -p 25222 -L 8000:localhost:8000 root@210.114.95.50 -N
# username/password 기본값 admin/changeme (config.py). 필요 시 아래로 덮어씀.
MONITOR_BASE_URL=http://localhost:8000/api/v2
