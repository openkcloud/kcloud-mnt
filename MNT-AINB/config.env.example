# MNT-AINB 로컬 설정 — cp config.env.example config.env
# 실행: uvicorn app.main:app --reload --port 8300 --env-file config.env
# 파드에서는 같은 키를 ConfigMap/Secret 으로 주입한다(charts/openkcloud-portal values.yaml 의 backends.ainb).

# ── 포털 연동 ─────────────────────────────────────────────────────
API_PREFIX=/api/ainb
CORE_API_BASE=http://localhost:8000          # 포털 로그인 확인(MNT-CORE /api/core/auth/login)
TEMPORAL_API_BASE=localhost:7233             # AI 워크스페이스 프로비저닝 작업 워커(큐 okc-ainb). 비우면 워커 안 띄움
# 브라우저(로컬 dev 프론트)에서 직접 호출할 때만 필요. 게이트웨이(single-origin) 구성이면 비운다
CORS_ORIGINS=http://localhost:3000
# 브라우저가 여는 포털 주소 — 노트북 IDE 주소(/notebook/...) 발급에 쓴다
PUBLIC_BASE_URL=http://localhost:3000
# IDE 세션 서명 키(Secret). 비우면 CMP_SECRET_FILE(기본 ~/.cmp-secret)에 만들어 쓴다
CMP_SESSION_SECRET=

# ── 노트북을 띄울 서비스 클러스터 ─────────────────────────────────
# kubeconfig 경로. 파드에서도 이 값을 주면 관리 클러스터가 아니라 이 클러스터를 조작한다(비우면 ~/.kube/config)
KUBECONFIG=
DEFAULT_NAMESPACE=okc
DEFAULT_NOTEBOOK_IMAGE=kubeflownotebookswg/jupyter-scipy:v1.9.2
# 가속기 자원 이름 — NVIDIA GPU: nvidia.com/gpu, Furiosa RNGD: furiosa.ai/rngd, Rebellions ATOM: rebellions.ai/ATOM
ACCEL_RESOURCE=nvidia.com/gpu
# NVIDIA 전용 RuntimeClass 가 따로 있는 클러스터만 nvidia (GPU Operator·NPU 클러스터는 비움)
GPU_RUNTIME_CLASS=

# ── 모델 저장소 (Kubeflow Pipelines 의 MinIO 재사용) ─────────────
MODEL_STORE_ENDPOINT=minio-service.kubeflow:9000
MODEL_STORE_BUCKET=models
MODEL_STORE_KEY=minio
MODEL_STORE_SECRET=minio123
MODEL_STORE_SA=kserve-minio-sa
SNAPSHOT_BUCKET=snapshots

# ── 성능 분석 대상 LLM (namespace/service) ────────────────────────
LLM_SERVICE=
LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
BENCH_IMAGE=kubeflownotebookswg/jupyter-pytorch-cuda-full:v1.9.2
