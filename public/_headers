# Netlify edge headers
# Ensure Service Worker is served with correct MIME and not cached aggressively.

/mockServiceWorker.js
  Content-Type: application/javascript; charset=utf-8
  Service-Worker-Allowed: /
  Cache-Control: no-cache, no-store, must-revalidate

# 이전 버전 스냅샷(public/versions/<id>/)의 Service Worker
/versions/:id/mockServiceWorker.js
  Content-Type: application/javascript; charset=utf-8
  Service-Worker-Allowed: /
  Cache-Control: no-cache, no-store, must-revalidate
